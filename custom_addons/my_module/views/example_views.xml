<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========== 表单视图 ========== -->
    <record id="view_my_example_form" model="ir.ui.view">
        <field name="name">my.example.form</field>
        <field name="model">my.example</field>
        <field name="arch" type="xml">
            <form string="示例记录">
                <header>
                    <button name="action_confirm" string="确认" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="完成" type="object"
                            class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="取消" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" string="重置为草稿" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="输入名称..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="基本信息">
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group string="日期和金额">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="amount"/>
                            <field name="quantity"/>
                            <field name="total_amount"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="描述" name="description">
                            <field name="description" placeholder="输入详细描述..."/>
                        </page>
                        <page string="其他信息" name="other">
                            <group>
                                <group>
                                    <field name="sequence"/>
                                    <field name="active"/>
                                </group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- ========== 列表视图 ========== -->
    <record id="view_my_example_tree" model="ir.ui.view">
        <field name="name">my.example.tree</field>
        <field name="model">my.example</field>
        <field name="arch" type="xml">
            <list string="示例记录">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="total_amount" sum="总计"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    
    <!-- ========== 搜索视图 ========== -->
    <record id="view_my_example_search" model="ir.ui.view">
        <field name="name">my.example.search</field>
        <field name="model">my.example</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <filter string="我的记录" name="my_records" domain="[('user_id', '=', uid)]"/>
                <filter string="草稿" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="已确认" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="已完成" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="按负责人" name="group_user" context="{'group_by': 'user_id'}"/>
                <filter string="按状态" name="group_state" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
    
    <!-- ========== 动作 ========== -->
    <record id="action_my_example" model="ir.actions.act_window">
        <field name="name">示例记录</field>
        <field name="res_model">my.example</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_records': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                创建第一个示例记录
            </p>
        </field>
    </record>
    
    <!-- ========== 标签视图 ========== -->
    <record id="view_my_example_tag_tree" model="ir.ui.view">
        <field name="name">my.example.tag.tree</field>
        <field name="model">my.example.tag</field>
        <field name="arch" type="xml">
            <list string="标签" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    
    <record id="action_my_example_tag" model="ir.actions.act_window">
        <field name="name">标签</field>
        <field name="res_model">my.example.tag</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
